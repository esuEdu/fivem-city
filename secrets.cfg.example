# Copy this file to secrets.cfg and fill in the values.
# secrets.cfg is gitignored — never commit real keys.

# https://portal.cfx.re -> Server Registration Keys
sv_licenseKey "changeme"

# https://steamcommunity.com/dev/apikey (optional, enables Steam identifiers)
set steam_webApiKey "none"

# MySQL / MariaDB connection used by oxmysql
set mysql_connection_string "mysql://root:password@localhost:3306/fivem_city?charset=utf8mb4"

# rcon_password "changeme"
