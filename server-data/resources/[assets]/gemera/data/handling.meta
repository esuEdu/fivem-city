<?xml version="1.0" encoding="UTF-8"?>
<!-- Koenigsegg Gemera HV8 (2024). Real car: ~2,300 hp / 2,750 Nm (E85), ~2,040 kg, AWD with torque
     vectoring and rear-wheel steering, 9-speed LST, 4 seats, 3.00 m wheelbase.
     Calibrated against GTA's Entity MT (Koenigsegg Jesko: 1,420 kg, RWD, drive force 0.3545):
     the Gemera has about the same power-to-weight, so similar drive force, but it is heavier,
     AWD (launches harder, less wheelspin), rear-biased, and sprung softer as a 4-seat GT. -->
<CHandlingDataMgr>
  <HandlingData>
    <Item type="CHandlingData">
      <handlingName>GEMERA</handlingName>
      <fMass value="2040.000000" />
      <fInitialDragCoeff value="8.600000" />
      <fDownforceModifier value="150.000000" />
      <fPercentSubmerged value="85.000000" />
      <!-- mid-engine V8 + battery behind the rear seats: centre of mass slightly rearward and low -->
      <vecCentreOfMassOffset x="0.000000" y="-0.080000" z="-0.050000" />
      <vecInertiaMultiplier x="1.000000" y="1.250000" z="1.200000" />
      <!-- AWD, rear-biased -->
      <fDriveBiasFront value="0.350000" />
      <!-- real car has 9 gears; 8 is the most any GTA vehicle uses -->
      <nInitialDriveGears value="8" />
      <fInitialDriveForce value="0.360000" />
      <fDriveInertia value="1.000000" />
      <fClutchChangeRateScaleUpShift value="8.000000" />
      <fClutchChangeRateScaleDownShift value="8.000000" />
      <fInitialDriveMaxFlatVel value="166.000000" />
      <!-- carbon-ceramic brakes on a 2-tonne car -->
      <fBrakeForce value="1.050000" />
      <fBrakeBiasFront value="0.550000" />
      <fHandBrakeForce value="0.600000" />
      <!-- rear-wheel steering tightens the turning circle -->
      <fSteeringLock value="42.000000" />
      <fTractionCurveMax value="2.750000" />
      <fTractionCurveMin value="2.550000" />
      <fTractionCurveLateral value="22.500000" />
      <fTractionSpringDeltaMax value="0.150000" />
      <fLowSpeedTractionLossMult value="0.800000" />
      <fCamberStiffnesss value="0.000000" />
      <fTractionBiasFront value="0.480000" />
      <fTractionLossMult value="1.000000" />
      <fSuspensionForce value="1.900000" />
      <fSuspensionCompDamp value="1.500000" />
      <fSuspensionReboundDamp value="2.600000" />
      <fSuspensionUpperLimit value="0.060000" />
      <fSuspensionLowerLimit value="-0.080000" />
      <!-- body sits 13 cm lower over the wheels (it rode too high in game) -->
      <fSuspensionRaise value="-0.130000" />
      <fSuspensionBiasFront value="0.470000" />
      <fAntiRollBarForce value="0.600000" />
      <fAntiRollBarBiasFront value="0.450000" />
      <fRollCentreHeightFront value="0.120000" />
      <fRollCentreHeightRear value="0.120000" />
      <fCollisionDamageMult value="1.000000" />
      <fWeaponDamageMult value="1.000000" />
      <fDeformationDamageMult value="0.700000" />
      <fEngineDamageMult value="1.500000" />
      <fPetrolTankVolume value="75.000000" />
      <fOilVolume value="5.000000" />
      <fSeatOffsetDistX value="0.000000" />
      <fSeatOffsetDistY value="0.000000" />
      <fSeatOffsetDistZ value="0.000000" />
      <nMonetaryValue value="1700000" />
      <strModelFlags>440010</strModelFlags>
      <strHandlingFlags>20000</strHandlingFlags>
      <strDamageFlags>0</strDamageFlags>
      <AIHandling>SPORTS_CAR</AIHandling>
      <SubHandlingData>
        <Item type="CCarHandlingData">
          <fBackEndPopUpCarImpulseMult value="0.100000" />
          <fBackEndPopUpBuildingImpulseMult value="0.030000" />
          <fBackEndPopUpMaxDeltaSpeed value="0.600000" />
          <fToeFront value="0.000000" />
          <fToeRear value="0.000000" />
          <fCamberFront value="0.000000" />
          <fCamberRear value="0.000000" />
          <fCastor value="0.000000" />
          <fEngineResistance value="0.000000" />
          <fMaxDriveBiasTransfer value="-1.000000" />
          <fJumpForceScale value="1.000000" />
          <fIncreasedRammingForceScale value="1.000000" />
          <strAdvancedFlags>0</strAdvancedFlags>
          <AdvancedData />
        </Item>
        <Item type="NULL" />
        <Item type="NULL" />
      </SubHandlingData>
    </Item>
  </HandlingData>
</CHandlingDataMgr>
