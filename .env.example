# Copy to .env (gitignored) and fill in.
# https://portal.cfx.re -> Server Registration Keys
CFX_LICENSE_KEY=changeme

# Letters and numbers only (it goes into a connection URL)
MYSQL_ROOT_PASSWORD=changeme
MYSQL_DATABASE=fivem_city

# Optional: YouTube Data API v3 key, so the phone's Music app can search songs by title
# (Google Cloud console -> APIs & Services -> enable "YouTube Data API v3" -> Credentials -> API key).
# Without it, players can still paste YouTube or .mp3 links.
YOUTUBE_API_KEY=

# Optional: pin an FXServer build instead of the current "recommended" one
# (rebuild with: docker compose up -d --build)
# FIVEM_ARTIFACT_URL=https://runtime.fivem.net/artifacts/fivem/build_proot_linux/master/<build>/fx.tar.xz
