diff --git a/server-data/resources/[ox]/ox_doorlock/web/city/style.css b/server-data/resources/[ox]/ox_doorlock/web/city/style.css
new file mode 100644
index 0000000..d450bd5
--- /dev/null
+++ b/server-data/resources/[ox]/ox_doorlock/web/city/style.css
@@ -0,0 +1,91 @@
+/* fivem-city: ox_doorlock's panel. Colors, radius and font come from city_ui/theme.lua (setTheme); the values after
+   each var() are only fallbacks. No backdrop-filter: FiveM's NUI draws it black. */
+* { box-sizing: border-box; }
+html, body { margin: 0; height: 100%; overflow: hidden; background: transparent; font-family: var(--font, 'Poppins', sans-serif); color: var(--text, #eef0f3); }
+.hidden { display: none !important; }
+button { font: inherit; }
+
+.panel { position: fixed; top: 50%; left: 50%; width: min(1040px, 94vw); height: min(720px, 90vh); transform: translate(-50%, -50%); display: flex; flex-direction: column; border-radius: var(--radius-large, 22px); background: rgba(12, 13, 18, 0.97); border: 1px solid var(--border, rgba(255, 255, 255, 0.06)); box-shadow: 0 30px 80px rgba(0, 0, 0, 0.6); overflow: hidden; animation: fade 0.18s ease; }
+
+.head { display: flex; align-items: center; gap: 12px; padding: 16px 18px; border-bottom: 1px solid var(--border, rgba(255, 255, 255, 0.06)); background: var(--section, rgba(255, 255, 255, 0.035)); }
+.titles { flex-grow: 1; min-width: 0; }
+.titles h1 { margin: 0; font-size: 21px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.titles small { font-size: 11px; color: var(--muted, #7d8590); }
+.head-actions { display: flex; gap: 6px; }
+
+.btn { height: 36px; padding: 0 14px; display: inline-flex; align-items: center; justify-content: center; gap: 7px; border: 1px solid rgba(255, 255, 255, 0.09); border-radius: var(--radius, 10px); background: var(--slot-hover, rgba(255, 255, 255, 0.07)); color: var(--text, #eef0f3); font-size: 12px; font-weight: 700; cursor: pointer; }
+.btn:hover { border-color: rgba(255, 255, 255, 0.18); }
+.btn.accent { background: var(--accent, #f5c542); color: var(--accent-text, #15181d); border-color: transparent; }
+.btn.small { height: 30px; padding: 0 10px; font-size: 11px; }
+.btn.big { height: 42px; padding: 0 22px; font-size: 13px; }
+.btn svg, .icon-btn svg { fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
+
+.icon-btn { width: 34px; height: 34px; flex-shrink: 0; display: grid; place-items: center; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius, 10px); background: var(--slot, rgba(255, 255, 255, 0.03)); color: var(--text, #eef0f3); cursor: pointer; }
+.icon-btn:hover { background: var(--slot-hover, rgba(255, 255, 255, 0.07)); }
+.icon-btn.close { font-size: 20px; line-height: 1; background: var(--danger, #e5484d); border-color: transparent; color: #fff; }
+.icon-btn.danger:hover, .icon-btn.sure { color: var(--danger, #e5484d); border-color: var(--danger, #e5484d); }
+.icon-btn.sure { width: auto; padding: 0 10px; font-size: 11px; font-weight: 700; }
+
+.body { flex-grow: 1; min-height: 0; overflow-y: auto; padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 12px; }
+
+.field { width: 100%; height: 38px; padding: 0 12px; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: var(--radius, 10px); background: rgba(0, 0, 0, 0.25); color: var(--text, #eef0f3); font: inherit; font-size: 13px; outline: none; }
+.field:focus { border-color: var(--accent, #f5c542); }
+.field.narrow { width: 120px; flex-shrink: 0; }
+select.field { cursor: pointer; }
+select.field option { background: #15171d; }
+
+/* List */
+.search { position: relative; }
+.search svg { position: absolute; left: 12px; top: 11px; fill: none; stroke: var(--muted, #7d8590); stroke-width: 2; }
+.search .field { padding-left: 36px; }
+.rows { display: flex; flex-direction: column; gap: 6px; }
+.row { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 12px; background: var(--slot, rgba(255, 255, 255, 0.03)); border: 1px solid var(--border, rgba(255, 255, 255, 0.06)); }
+.row:hover { background: var(--slot-hover, rgba(255, 255, 255, 0.07)); }
+.row .id { width: 44px; font-family: var(--mono, monospace); font-size: 12px; color: var(--muted, #7d8590); }
+.row .grow { flex-grow: 1; min-width: 0; display: flex; flex-direction: column; }
+.row strong { font-size: 14px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.row small { font-size: 11px; color: var(--muted, #7d8590); }
+.state { width: 30px; height: 30px; flex-shrink: 0; display: grid; place-items: center; border-radius: 15px; border: 1.5px solid currentColor; }
+.state svg { fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
+.state.locked { color: var(--danger, #e5484d); }
+.state.open { color: var(--success, #3ecf72); }
+.chip { max-width: 220px; padding: 4px 10px; border-radius: 12px; background: var(--accent-soft, rgba(245, 197, 66, 0.1)); color: var(--accent, #f5c542); font-size: 11px; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.row-actions { display: flex; gap: 6px; }
+.empty { margin: 30px 0; text-align: center; color: var(--muted, #7d8590); }
+.empty.small { margin: 4px 0; font-size: 12px; text-align: left; }
+
+/* Form */
+.form { display: flex; flex-direction: column; gap: 12px; }
+.two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
+.card { padding: 14px; border-radius: 14px; background: var(--section, rgba(255, 255, 255, 0.035)); border: 1px solid var(--border, rgba(255, 255, 255, 0.06)); display: flex; flex-direction: column; gap: 12px; }
+.card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
+.card-head strong { display: block; font-size: 14px; }
+.card-head small { font-size: 11px; color: var(--muted, #7d8590); }
+.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px 12px; }
+.field-box { display: flex; flex-direction: column; gap: 5px; }
+.label { font-size: 10px; font-weight: 700; letter-spacing: 1.2px; text-transform: uppercase; color: var(--muted, #7d8590); }
+.hint { font-size: 10px; color: var(--muted, #7d8590); }
+.list { display: flex; flex-direction: column; gap: 6px; }
+.list-row { display: flex; align-items: center; gap: 6px; }
+.custom { display: flex; gap: 6px; }
+
+.toggles { display: flex; flex-wrap: wrap; gap: 8px; }
+.toggle { height: 36px; padding: 0 12px 0 8px; display: inline-flex; align-items: center; gap: 8px; border-radius: var(--radius, 10px); background: var(--slot, rgba(255, 255, 255, 0.03)); border: 1px solid rgba(255, 255, 255, 0.08); font-size: 12px; font-weight: 600; cursor: pointer; user-select: none; }
+.toggle.compact { height: 38px; flex-shrink: 0; }
+.toggle.disabled { opacity: 0.45; cursor: default; }
+.toggle input { position: absolute; opacity: 0; pointer-events: none; }
+.toggle i { position: relative; width: 30px; height: 18px; border-radius: 9px; background: rgba(255, 255, 255, 0.14); transition: background 0.15s; }
+.toggle i::after { content: ''; position: absolute; top: 2px; left: 2px; width: 14px; height: 14px; border-radius: 7px; background: #fff; transition: transform 0.15s; }
+.toggle input:checked + i { background: var(--accent, #f5c542); }
+.toggle input:checked + i::after { transform: translateX(12px); background: var(--accent-text, #15181d); }
+.toggle input:focus-visible + i { outline: 2px solid var(--accent, #f5c542); outline-offset: 2px; }
+
+.foot { position: sticky; bottom: -18px; margin: 0 -18px -18px; padding: 12px 18px; display: flex; justify-content: flex-end; gap: 8px; border-top: 1px solid var(--border, rgba(255, 255, 255, 0.06)); background: rgba(12, 13, 18, 0.98); }
+
+.toast { position: fixed; left: 50%; bottom: 40px; transform: translateX(-50%); padding: 10px 18px; border-radius: var(--radius, 10px); background: rgba(12, 13, 18, 0.97); border: 1px solid var(--accent, #f5c542); font-size: 13px; font-weight: 600; }
+
+::-webkit-scrollbar { width: 8px; height: 8px; }
+::-webkit-scrollbar-track { background: transparent; }
+::-webkit-scrollbar-thumb { border: 2px solid transparent; border-radius: 4px; background: rgba(255, 255, 255, 0.14); background-clip: padding-box; }
+
+@keyframes fade { from { opacity: 0; transform: translate(-50%, -48%); } to { opacity: 1; transform: translate(-50%, -50%); } }
